---
import '../styles/tokens.css';
import '../styles/basis.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sponsorbalk from '../components/Sponsorbalk.astro';
import WhatsAppKnop from '../components/WhatsAppKnop.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import nav from '../content/nl/navigatie.json';
import paginas from '../content/nl/paginas.json';

const { pad, meta: metaProp, posterPreload, wa = 'algemeen', faq } = Astro.props;
const meta = metaProp ?? paginas[pad];
const canoniek = new URL(pad, Astro.site).href;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {posterPreload && (
      <link rel="preload" as="image" type="image/webp"
            href={posterPreload.webp_1920}
            imagesrcset={`${posterPreload.webp_1024} 1024w, ${posterPreload.webp_1920} 1920w`}
            imagesizes="100vw" fetchpriority="high" />
    )}
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{meta.titel}</title>
    <meta name="description" content={meta.beschrijving} />
    <link rel="canonical" href={canoniek} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.titel} />
    <meta property="og:description" content={meta.beschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:locale" content="nl_NL" />
    {pad === '/' && <SchemaOrg />}
    {faq && <SchemaOrg faq={faq} />}
    <slot name="head" />
  </head>
  <body>
    <a class="overslaan" href="#inhoud">{nav.labels.naarHoofdinhoud}</a>
    <Header pad={pad} />
    <main id="inhoud">
      <slot />
    </main>
    <Sponsorbalk />
    <Footer />
    <WhatsAppKnop sleutel={wa} />
  </body>
</html>
