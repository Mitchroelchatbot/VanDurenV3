---
import Foto from './Foto.astro';
import home from '../content/nl/homepage.json';

const b = home.beeldblok;
const tonen = b.fotos.length > 0;
---
{tonen && (
  <section class="sectie sectie--licht">
    <div class="omhulsel">
      <h2>{b.kop}</h2>
      <div class="beeldblok__raster">
        {b.fotos.map((f) => (
          <figure class="beeldblok__item">
            <Foto basis={f.basis} maten={f.maten} alt={f.alt} breedte={f.breedte} hoogte={f.hoogte} />
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .beeldblok__raster {
    display: grid; gap: var(--gutter);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .beeldblok__item { margin: 0; }
  .beeldblok__item :global(img) {
    border-radius: var(--radius);
    width: 100%; height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
</style>
