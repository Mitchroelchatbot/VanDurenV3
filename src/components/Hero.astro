---
import home from '../content/nl/home.json';
import bedrijf from '../content/nl/bedrijf.json';
import Cta from './Cta.astro';
import { bestaat } from '../lib/beeld.js';

const h = home.hero;
const poster = h.poster;
const video = h.video;
// Staande varianten (15 september 2026): onder 768px is de hero een staande
// box; een liggende poster wordt daar met object-fit: cover 3,6× opgeblazen.
// De staande bestanden renderen alleen als het veld én het bestand bestaan;
// ontbreken ze, dan valt alles terug op de liggende posters zoals voorheen.
const staand1080 = poster?.webp_staand_1080 && bestaat(poster.webp_staand_1080) ? poster.webp_staand_1080 : null;
const staand720 = poster?.webp_staand_720 && bestaat(poster.webp_staand_720) ? poster.webp_staand_720 : null;
const videoStaand1080 = video?.mp4_staand_1080 && bestaat(video.mp4_staand_1080) ? video.mp4_staand_1080 : null;
const videoStaand720 = video?.mp4_staand_720 && bestaat(video.mp4_staand_720) ? video.mp4_staand_720 : null;
// De <video> krijgt statisch géén src: dan haalt de browser onder 768px en bij
// prefers-reduced-motion niets op, ook niet de metadata. Het script kiest de
// bron per breedte en zet hem pas dan. preload="metadata" geldt vanaf dat moment.
---
<section class="hero op-beeld">
  {poster && (
    <picture>
      {/* De MEDIA QUERY kiest de beeldverhouding (staand onder 768px); de
          srcset daarbinnen kiest de dichtheid. Een grens op CSS-pixels alleen
          (720 tot 430px) gaf op DPR 3 het 720-bestand in een box van 1170px
          breed: 1,62× opgeblazen. Met 720w/1080w kiest de browser op 390×844
          bij DPR 3 het 1080-bestand (1,08×), op DPR 2 het 720-bestand. */}
      {staand1080 && (
        <source type="image/webp" media="(max-width: 767px)" sizes="100vw"
                srcset={[staand720 ? `${staand720} 720w` : null, `${staand1080} 1080w`].filter(Boolean).join(', ')} />
      )}
      <source type="image/webp" sizes="100vw"
              srcset={`${poster.webp_1024} 1024w, ${poster.webp_1920} 1920w`} />
      <img class="hero__laag hero__poster" src={poster.jpg_1920} alt={poster.alt}
           width="1920" height="1080" fetchpriority="high" decoding="sync" />
    </picture>
  )}
  {video && (
    <video class="hero__laag hero__video" muted loop playsinline preload="none" aria-hidden="true"
           width="1600" height="900" data-hero-video
           data-src-1600={video.mp4_1600} data-src-960={video.mp4_960}
           data-src-staand-1080={videoStaand1080 ?? undefined} data-src-staand-720={videoStaand720 ?? undefined}></video>
  )}

  <div class="omhulsel hero__binnen">
    {h.toonSlogan && bedrijf.slogan && <p class="hero__kicker">{bedrijf.slogan}</p>}
    <h1 class="hero__kop">{h.kop}</h1>
    <p class="hero__onderkop">{h.tekst}</p>
    {h.knoppen?.length > 0 && (
      <div class="hero__acties" data-hero-acties>
        {h.knoppen.map((k) => (<Cta cta={k} soort={k.stijl ?? 'secundair'} />))}
      </div>
    )}
  </div>
</section>

<style>
  /* Hoogte: nooit 100vh (hero._regel_hoogte). Mobiel 82vh zodat h1, regel en
     beide knoppen boven de vouw staan en een strook van kernpunten zichtbaar
     blijft; desktop ~70vh. Fallback op vh voor browsers zonder svh. */
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; justify-content: flex-end;
    min-height: 82vh; min-height: 82svh;
    background: var(--blauw-diep);
  }
  @media (min-width: 900px) { .hero { min-height: 70vh; min-height: 70svh; } }
  .hero__laag { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }

  /* Lagen, van onder naar boven: poster (-4), video (-3), vlakke verdonkering
     0.15 (-2), scrim (-1), tekst. De poster is de LCP; de video ligt erover en
     fadet in zodra 'canplay' vuurt. */
  .hero__poster { z-index: -4; }
  .hero__video  { z-index: -3; opacity: 0; }
  .hero__video[data-kan-spelen] { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__video { transition: opacity 400ms ease-out; }
  }
  /* Bij prefers-reduced-motion nooit video. Onder 768px alleen de staande
     variant, en alleen onder de voorwaarden in het script (het verbod uit §5.2
     is op 15 september 2026 vervangen door die voorwaarden). */
  @media (prefers-reduced-motion: reduce) { .hero__video { display: none; } }
  @media (max-width: 767px) { .hero__video:not([data-src-staand-1080]) { display: none; } }

  /* Scrim (hero._regel, gemeten): minimaal rgba(20,22,28,0.70) achter tekst en
     knoppen, als bottom-up gradient over de onderste ~70 %, plus 0.15 vlak over
     het geheel. De inhoud staat onderin, binnen de zone van 0.70. De stop lag
     op 52 %; met de kicker (24 september 2026) stak die 9 px boven de zone uit
     (gemeten 390×844), daarom 56 %: de zone groeit mee met de tekst. */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -2;
    background: rgb(20 22 28 / 0.15);
  }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top,
      rgb(20 22 28 / 0.70) 0%, rgb(20 22 28 / 0.70) 56%,
      rgb(20 22 28 / 0.35) 66%, rgb(20 22 28 / 0) 76%);
  }

  .hero__binnen { position: relative; padding-block: clamp(2rem, 6vh, 4rem) clamp(2.5rem, 7vh, 4.5rem); }
  /* Centrering komt uit tokens.css regel 4 via de klasse .hero. */
  /* Kicker: de slogan uit bedrijf.json boven de h1 (home.hero._toonSlogan). Geen kop-element: de h1 draagt de zoekterm. */
  .hero__kicker { font-family: var(--font-kop); font-weight: 600; font-size: clamp(0.85rem, 1.6vw, 1rem); letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.6rem; opacity: 0.95; }
  .hero__kop { max-width: 20ch; margin-inline: auto; margin-bottom: 0.4em; }
  .hero__onderkop { font-size: clamp(1.05rem, 2.2vw, 1.3rem); margin: 0 auto 1.5rem; max-width: 40ch; }

  /* Knoppen (hero._regel_knoppen): minimaal 48 px hoog, 16 px ertussen; op
     mobiel volle breedte. De ring op de primaire knop komt uit tokens.css
     (.op-beeld), de witte rand van de secundaire uit basis.css. */
  .hero__acties { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .hero__acties :global(.knop) { min-height: 48px; }
  @media (max-width: 559px) {
    .hero__acties { flex-direction: column; align-items: stretch; }
    .hero__acties :global(.knop) { width: 100%; }
  }
</style>

<script>
  // Bron per breedte: hero-1600 boven 1024px, hero-960 van 768 tot 1024px.
  // Onder 768px de staande variant (720 tot 430px, anders 1080), maar alleen
  // als alle vier waar zijn: de poster is geschilderd, saveData staat uit, de
  // verbinding is 4g, en prefers-reduced-motion staat uit. Ontbreekt
  // navigator.connection (Safari), dan wel laden. De src wordt altijd pas
  // gezet nadat de poster geschilderd is, zodat de video nooit de LCP is.
  const v = document.querySelector('[data-hero-video]');
  const poster = document.querySelector('.hero__poster');
  const rm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const kies = () => {
    const w = window.innerWidth;
    if (rm.matches) return null;
    if (w >= 768) return v.getAttribute(w > 1024 ? 'data-src-1600' : 'data-src-960');
    const c = navigator.connection;
    if (c && (c.saveData || c.effectiveType !== '4g')) return null;
    // getAttribute, geen dataset: een streepje vóór een cijfer blijft in de sleutel staan.
    return (w <= 430 && v.getAttribute('data-src-staand-720')) || v.getAttribute('data-src-staand-1080');
  };
  if (v) {
    const start = () => {
      const src = kies();
      if (!src) return;
      v.addEventListener('canplay', () => v.setAttribute('data-kan-spelen', ''), { once: true });
      v.src = src;
      v.play().catch(() => {});
    };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300));
    // Eerst de poster laten schilderen: decode() lost op zodra hij getekend kan worden.
    const geschilderd = poster && 'decode' in poster ? poster.decode().catch(() => {}) : Promise.resolve();
    geschilderd.then(() => requestAnimationFrame(() => requestAnimationFrame(idle)));
  }
</script>
