---
import bedrijf from '../content/nl/bedrijf.json';
import home from '../content/nl/homepage.json';
import paginas from '../content/nl/paginas.json';

const h = home.hero;
const primairHref = h.primair.soort === 'playtomic' ? bedrijf.playtomic : h.primair.pad;
---
<section class="hero op-blauw">
  {h.video && (
    <video class="hero__video" autoplay muted loop playsinline poster={h.poster ? `${h.poster.basis}-1434.webp` : undefined}>
      <source src={h.video.webm} type="video/webm" />
      <source src={h.video.mp4} type="video/mp4" />
    </video>
  )}
  {!h.video && h.poster && (
    <picture>
      <source type="image/avif" sizes="100vw"
              srcset={`${h.poster.basis}-960.avif 960w, ${h.poster.basis}-1434.avif 1434w`} />
      <source type="image/webp" sizes="100vw"
              srcset={`${h.poster.basis}-960.webp 960w, ${h.poster.basis}-1434.webp 1434w`} />
      <img class="hero__video" src={`${h.poster.basis}-1434.webp`} alt={h.posterAlt}
           width={h.poster.breedte} height={h.poster.hoogte} fetchpriority="high" decoding="sync" />
    </picture>
  )}

  <div class="omhulsel hero__binnen">
    <h1 class="hero__kop">{paginas['/'].h1}</h1>
    <p class="hero__onderkop">{h.onderkop}</p>
    <div class="hero__acties">
      <a class="knop knop--primair" href={primairHref} rel="noopener">{h.primair.label}</a>
      <a class="knop knop--secundair" href={h.secundair.pad}>{h.secundair.label}</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; }
  .hero__video {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover;
  }
  /* Leesbaarheidslaag. Richtingsgevoelig: zwaar aan de kant waar de tekst
     staat, licht aan de andere kant, zodat de foto herkenbaar blijft. Bij
     0.92 dekking is de ondergrond feitelijk --blauw-diep, en wit haalt daar
     13,59:1. Zonder beeld valt de laag weg en blijft het effen blauw. */
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, rgb(20 42 100 / 0.92) 0%, rgb(20 42 100 / 0.86) 38%,
                              rgb(20 42 100 / 0.55) 68%, rgb(20 42 100 / 0.42) 100%),
      linear-gradient(180deg, rgb(20 42 100 / 0.35), rgb(20 42 100 / 0.55));
  }
  @media (max-width: 899px) {
    /* Op smalle schermen loopt de tekst over de volle breedte, dus daar een
       gelijkmatige laag in plaats van een zijdelingse. */
    .hero::after {
      background: linear-gradient(180deg, rgb(20 42 100 / 0.78), rgb(20 42 100 / 0.88));
    }
  }
  .hero:not(:has(.hero__video))::after { background: none; }

  .hero__binnen { padding-block: clamp(72px, 14vw, 152px); }
  .hero__kop, .hero__onderkop, .hero__acties { max-width: 40rem; }
  .hero__kop { margin-bottom: 0.4em; }
  .hero__onderkop {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    margin-bottom: 2rem;
    opacity: 0.95;
  }
  .hero__acties { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  @media (max-width: 767px) {
    /* §5.2: onder 768px geen video, maar wél de poster. Alleen het
       video-element verbergen, niet de afbeelding die dezelfde klasse deelt. */
    .hero video.hero__video { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero video.hero__video { display: none; }
  }
</style>
