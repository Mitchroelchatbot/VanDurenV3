---
import home from '../content/nl/home.json';
import Cta from './Cta.astro';

const h = home.hero;
const poster = h.poster;
const video = h.video;
// De <video> krijgt statisch géén src: dan haalt de browser onder 768px en bij
// prefers-reduced-motion niets op, ook niet de metadata. Het script kiest de
// bron per breedte en zet hem pas dan. preload="metadata" geldt vanaf dat moment.
---
<section class="hero op-beeld">
  {poster && (
    <picture>
      <source type="image/webp" sizes="100vw"
              srcset={`${poster.webp_1024} 1024w, ${poster.webp_1920} 1920w`} />
      <img class="hero__laag hero__poster" src={poster.jpg_1920} alt={poster.alt}
           width="1920" height="1080" fetchpriority="high" decoding="sync" />
    </picture>
  )}
  {video && (
    <video class="hero__laag hero__video" muted loop playsinline preload="metadata" aria-hidden="true"
           width="1600" height="900" data-hero-video
           data-src-1600={video.mp4_1600} data-src-960={video.mp4_960}></video>
  )}

  <div class="omhulsel hero__binnen">
    <h1 class="hero__kop">{h.kop}</h1>
    <p class="hero__onderkop">{h.tekst}</p>
    {h.knoppen?.length > 0 && (
      <div class="hero__acties" data-hero-acties>
        {h.knoppen.map((k) => (<Cta cta={k} soort={k.stijl ?? 'secundair'} />))}
      </div>
    )}
  </div>
</section>

<style>
  /* Hoogte: nooit 100vh (hero._regel_hoogte). Mobiel 82vh zodat h1, regel en
     beide knoppen boven de vouw staan en een strook van kernpunten zichtbaar
     blijft; desktop ~70vh. Fallback op vh voor browsers zonder svh. */
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; justify-content: flex-end;
    min-height: 82vh; min-height: 82svh;
    background: var(--blauw-diep);
  }
  @media (min-width: 900px) { .hero { min-height: 70vh; min-height: 70svh; } }
  .hero__laag { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }

  /* Lagen, van onder naar boven: poster (-4), video (-3), vlakke verdonkering
     0.15 (-2), scrim (-1), tekst. De poster is de LCP; de video ligt erover en
     fadet in zodra 'canplay' vuurt. */
  .hero__poster { z-index: -4; }
  .hero__video  { z-index: -3; opacity: 0; }
  .hero__video[data-kan-spelen] { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__video { transition: opacity 500ms ease-out; }
  }
  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
  }

  /* Scrim (hero._regel, gemeten): minimaal rgba(20,22,28,0.70) achter tekst en
     knoppen, als bottom-up gradient over de onderste ~70 %, plus 0.15 vlak over
     het geheel. De inhoud staat onderin, binnen de zone van 0.70. */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -2;
    background: rgb(20 22 28 / 0.15);
  }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top,
      rgb(20 22 28 / 0.70) 0%, rgb(20 22 28 / 0.70) 52%,
      rgb(20 22 28 / 0.35) 62%, rgb(20 22 28 / 0) 72%);
  }

  .hero__binnen { position: relative; padding-block: clamp(2rem, 6vh, 4rem) clamp(2.5rem, 7vh, 4.5rem); }
  /* Centrering komt uit tokens.css regel 4 via de klasse .hero. */
  .hero__kop { max-width: 20ch; margin-inline: auto; margin-bottom: 0.4em; }
  .hero__onderkop { font-size: clamp(1.05rem, 2.2vw, 1.3rem); margin: 0 auto 1.5rem; max-width: 40ch; }

  /* Knoppen (hero._regel_knoppen): minimaal 48 px hoog, 16 px ertussen; op
     mobiel volle breedte. De ring op de primaire knop komt uit tokens.css
     (.op-beeld), de witte rand van de secundaire uit basis.css. */
  .hero__acties { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .hero__acties :global(.knop) { min-height: 48px; }
  @media (max-width: 559px) {
    .hero__acties { flex-direction: column; align-items: stretch; }
    .hero__acties :global(.knop) { width: 100%; }
  }
</style>

<script>
  // Bron per breedte: hero-1600 boven 1024px, hero-960 van 768 tot 1024px,
  // niets daaronder en niets bij prefers-reduced-motion. De src wordt pas
  // gezet nadat de poster geschilderd is, zodat de video nooit de LCP is.
  const v = document.querySelector('[data-hero-video]');
  const rm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const kies = () => {
    const w = window.innerWidth;
    if (rm.matches || w < 768) return null;
    // getAttribute, geen dataset: 'data-src-1600' wordt dataset['src-1600'],
    // want een streepje vóór een cijfer wordt niet weggehaald.
    return v.getAttribute(w > 1024 ? 'data-src-1600' : 'data-src-960');
  };
  if (v) {
    const start = () => {
      const src = kies();
      if (!src) return;
      v.addEventListener('canplay', () => v.setAttribute('data-kan-spelen', ''), { once: true });
      v.src = src;
      v.play().catch(() => {});
    };
    'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300);
  }
</script>
