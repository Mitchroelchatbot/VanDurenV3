---
import Cta from './Cta.astro';
import home from '../content/nl/home.json';

const h = home.hero;
const poster = h.poster;
const video = h.video;
const secundair = { label: h.secundair.label, href: h.secundair.href };
// De <video> krijgt statisch géén src: dan haalt de browser onder 768px en bij
// prefers-reduced-motion niets op, ook niet de metadata. Het script kiest de
// bron per breedte en zet hem pas dan. preload="metadata" geldt vanaf dat moment.
---
<section class="hero op-blauw">
  {poster && (
    <picture>
      <source type="image/webp" sizes="100vw"
              srcset={`${poster.webp_1024} 1024w, ${poster.webp_1920} 1920w`} />
      <img class="hero__laag hero__poster" src={poster.jpg_1920} alt={poster.alt}
           width="1920" height="1080" fetchpriority="high" decoding="sync" />
    </picture>
  )}
  {video && (
    <video class="hero__laag hero__video" muted loop playsinline preload="metadata" aria-hidden="true"
           width="1600" height="900" data-hero-video
           data-src-1600={video.mp4_1600} data-src-960={video.mp4_960}></video>
  )}

  <div class="omhulsel hero__binnen">
    <h1 class="hero__kop">{h.kop}</h1>
    <p class="hero__onderkop">{h.tekst}</p>
    <div class="hero__acties">
      <Cta cta={h.primair} soort="primair" />
      <Cta cta={secundair} soort="secundair" />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; }
  .hero__laag { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Lagen, van onder naar boven: poster (-3), video (-2), blauwe laag (-1),
     tekst. De poster is de LCP; de video ligt erover en fadet in zodra
     'canplay' vuurt. Zonder video blijft de poster gewoon staan. */
  .hero__poster { z-index: -3; }
  .hero__video  { z-index: -2; opacity: 0; }
  .hero__video[data-kan-spelen] { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__video { transition: opacity 500ms ease-out; }
  }
  /* Onder 768px en bij prefers-reduced-motion: geen video, alleen de poster.
     Het script laadt hem dan ook niet; dit is de tweede grendel. */
  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
  }

  /* Overlay maximaal 35 % blauw. De tekst staat gecentreerd, dus de laag ook:
     het donkerst in het midden achter de tekst en transparant naar beide
     randen, zodat het beeld zijn kleur houdt. */
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg,
      rgb(20 42 100 / 0.05) 0%, rgb(20 42 100 / 0.35) 24%,
      rgb(20 42 100 / 0.35) 76%, rgb(20 42 100 / 0.05) 100%);
  }
  .hero:not(:has(.hero__laag))::after { background: none; }
  @media (max-width: 899px) {
    .hero::after { background: rgb(20 42 100 / 0.35); }
    .hero__laag { object-position: 50% 88%; }
  }

  .hero__binnen { position: relative; padding-block: clamp(72px, 14vw, 152px); }
  /* Achter de tekst wordt het beeld lokaal donkerder gemaakt met een
     helderheidsfilter, niet met een kleurlaag: de tint blijft, alleen lichte
     glaswanden en lampen achter de letters dempen. Symmetrisch, want de tekst
     staat gecentreerd. Waarde gemeten op letterniveau over de hele videolus. */
  .hero__binnen::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    left: 50%; transform: translateX(-50%);
    width: min(100vw, 62rem);
    -webkit-backdrop-filter: brightness(0.5); backdrop-filter: brightness(0.5);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }
  @media (max-width: 899px) {
    .hero__binnen::before { width: 100vw; -webkit-mask-image: none; mask-image: none; }
  }
  /* Centrering komt uit tokens.css regel 4 via de klasse .hero. */
  .hero__kop { max-width: 20ch; margin-inline: auto; margin-bottom: 0.4em; }
  .hero__onderkop { font-size: clamp(1.05rem, 2.2vw, 1.3rem); margin-bottom: 2rem; opacity: 0.95; }
  .hero__acties { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; }
</style>

<script>
  // Bron per breedte: hero-1600 boven 1024px, hero-960 van 768 tot 1024px,
  // niets daaronder en niets bij prefers-reduced-motion. De src wordt pas
  // gezet nadat de poster geschilderd is, zodat de video nooit de LCP is.
  const v = document.querySelector('[data-hero-video]');
  const rm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const kies = () => {
    const w = window.innerWidth;
    if (rm.matches || w < 768) return null;
    // getAttribute, geen dataset: 'data-src-1600' wordt dataset['src-1600'],
    // want een streepje vóór een cijfer wordt niet weggehaald.
    return v.getAttribute(w > 1024 ? 'data-src-1600' : 'data-src-960');
  };
  if (v) {
    const start = () => {
      const src = kies();
      if (!src) return;
      v.addEventListener('canplay', () => v.setAttribute('data-kan-spelen', ''), { once: true });
      v.src = src;
      v.play().catch(() => {});
    };
    'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300);
  }
</script>
