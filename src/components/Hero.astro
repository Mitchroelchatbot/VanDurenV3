---
import Cta from './Cta.astro';
import home from '../content/nl/home.json';
import beeld from '../content/nl/home-beeld.json';

const h = home.hero;
// home.json geeft voor 'poster' een TODO-string; het echte posterbestand
// staat in het beeldmanifest. Een string die geen pad is rendert nooit.
const poster = beeld.poster;
// Video uit het beeldmanifest; home.json houdt hero.video op null tot het bestand er is.
const video = beeld.video ?? h.video;
const secundair = { label: h.secundair.label, href: h.secundair.href };
---
<section class="hero op-blauw">
  {/* §5.2: achtergrondloop, nooit geluid. De <picture> eronder is de poster:
      géén poster-attribuut, want dat laat de browser dat bestand nog een keer
      ophalen, ook op mobiel waar de video verborgen is, en dat vertraagt de
      LCP. preload=none: de video mag de LCP niet zijn. Onder 768px en bij
      prefers-reduced-motion wordt hij niet geladen (script onderaan). */}
  {video && (
    <video class="hero__video" muted loop playsinline preload="none" aria-hidden="true"
           width={video.breedte} height={video.hoogte} data-hero-video>
      <source data-src={video.webm} type="video/webm" />
      <source data-src={video.mp4} type="video/mp4" />
    </video>
  )}
  {poster && (
    <picture>
      <source type="image/avif" sizes="100vw"
              srcset={`${poster.basis}-640.avif 640w, ${poster.basis}-1024.avif 1024w`} />
      <source type="image/webp" sizes="100vw"
              srcset={`${poster.basis}-640.webp 640w, ${poster.basis}-1024.webp 1024w`} />
      <img class="hero__video" src={poster.jpg} alt={poster.alt}
           width={poster.breedte} height={poster.hoogte} fetchpriority="high" decoding="sync" />
    </picture>
  )}

  <div class="omhulsel hero__binnen">
    <h1 class="hero__kop">{h.kop}</h1>
    <p class="hero__onderkop">{h.tekst}</p>
    <div class="hero__acties">
      <Cta cta={h.primair} soort="primair" />
      <Cta cta={secundair} soort="secundair" />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; }
  .hero__video { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }

  /* Overlay maximaal 35 % blauw. De tekst staat sinds het uitlijningsbesluit
     gecentreerd, dus de laag is dat ook: het donkerst in het midden achter de
     tekst en transparant naar beide randen, zodat de foto zijn kleur houdt.
     Zonder beeld valt de laag weg en blijft het effen blauw. */
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg,
      rgb(20 42 100 / 0.05) 0%, rgb(20 42 100 / 0.35) 24%,
      rgb(20 42 100 / 0.35) 76%, rgb(20 42 100 / 0.05) 100%);
  }
  .hero:not(:has(.hero__video))::after { background: none; }
  @media (max-width: 899px) {
    /* Smal scherm: tekst over de volle breedte, dus een egale laag van 35 %. */
    .hero::after { background: rgb(20 42 100 / 0.35); }
    .hero__video { object-position: 50% 88%; }
  }

  .hero__binnen { position: relative; padding-block: clamp(72px, 14vw, 152px); }
  /* Achter de tekst wordt de foto lokaal donkerder gemaakt met een
     helderheidsfilter, niet met een kleurlaag: de tint blijft, alleen de
     lichte glaswanden en lampen achter de letters dempen. Dit is wat de
     35 %-laag alleen niet kan garanderen; zonder ondersteuning van
     backdrop-filter blijft de 35 %-laag over. Symmetrisch, want de tekst
     staat gecentreerd. */
  .hero__binnen::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    left: 50%; transform: translateX(-50%);
    width: min(100vw, 62rem);
    -webkit-backdrop-filter: brightness(0.5); backdrop-filter: brightness(0.5);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }
  @media (max-width: 899px) {
    .hero__binnen::before { width: 100vw; -webkit-mask-image: none; mask-image: none; }
  }
  /* Centrering komt uit tokens.css regel 4 via de klasse .hero. */
  .hero__kop { max-width: 20ch; margin-inline: auto; }
  .hero__kop { margin-bottom: 0.4em; }
  .hero__onderkop { font-size: clamp(1.05rem, 2.2vw, 1.3rem); margin-bottom: 2rem; opacity: 0.95; }
  .hero__acties { justify-content: center; }
  .hero__acties { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  /* De poster ligt altijd onder de video; de video ligt erbovenop zodra hij
     speelt. Zo is de poster de LCP en verschijnt de video zonder sprong. */
  .hero picture .hero__video { z-index: -3; }
  .hero video.hero__video { z-index: -2; opacity: 0; transition: opacity 400ms ease-out; }
  .hero video.hero__video[data-speelt] { opacity: 1; }
  @media (max-width: 767px) {
    /* §5.2: geen video onder 768 px, wél de poster. */
    .hero video.hero__video { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero video.hero__video { display: none; } }
</style>

<script>
  // Video pas laden als hij ook echt getoond wordt: niet onder 768px, niet bij
  // prefers-reduced-motion, en niet vóór de poster geschilderd is.
  const v = document.querySelector('[data-hero-video]');
  const mag = () => window.matchMedia('(min-width: 768px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (v && mag()) {
    const laad = () => {
      v.querySelectorAll('source[data-src]').forEach((s) => { s.src = s.dataset.src; s.removeAttribute('data-src'); });
      v.load();
      v.addEventListener('playing', () => v.setAttribute('data-speelt', ''), { once: true });
      v.play().catch(() => {});
    };
    'requestIdleCallback' in window ? requestIdleCallback(laad, { timeout: 1500 }) : setTimeout(laad, 300);
  }
</script>
