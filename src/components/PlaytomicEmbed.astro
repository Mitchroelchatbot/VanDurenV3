---
import banen from '../content/nl/banen.json';
import bedrijf from '../content/nl/bedrijf.json';

// White-label boekingskalender van Playtomic in een iframe.
// Het iframe komt PAS in de DOM als de bezoeker op de knop klikt (6 oktober 2026,
// A6): de privacyverklaring zegt dat Playtomic pas na een klik cookies kan
// plaatsen, dus niet meer bij scrollen en geen noscript-iframe.
// Onder het vlak staat ALTIJD de directe link naar Playtomic: zonder JavaScript,
// en als het vlak leeg blijft, is dat de werkende weg naar de boeking.
// 26 november 2026: de directe link ging naar de /wl/-URL; die is alleen voor
// het iframe en werkt niet als losse pagina. Hij wijst nu naar de gewone
// clubpagina uit bedrijf.json.
// Zolang websiteUrlGeregeld false is (O26), laadt het iframe niet en rendert
// deze sectie helemaal niet: een knop die een leeg vlak oplevert is erger dan
// geen knop. De kaart "Losse boeking" erboven linkt al naar Playtomic.
const p = banen.playtomic;
const toon = p && p.websiteUrlGeregeld;

if (p && !p.websiteUrlGeregeld) {
  console.warn(
    '\n[banen] Playtomic-embed staat UIT tot de website-URL in Playtomic Manager\n' +
    '        op het domein staat (OPEN.md O26). Zet dan banen.playtomic.websiteUrlGeregeld op true.\n'
  );
}
---
{toon && (
  <section class="sectie sectie--licht" id="boeken">
    <div class="omhulsel omhulsel--midden">
      {p.kop && <h2 class="sectie-kop">{p.kop}</h2>}
      {p.intro && <p class="intro-kort">{p.intro}</p>}

      <div class="playtomic" data-playtomic data-src={p.url} data-title={p.iframeTitel}>
        {/* Zichtbaar tot het iframe geladen is; daarna verborgen door het script. */}
        <div class="playtomic__wacht" data-playtomic-wacht>
          <button type="button" class="knop knop--secundair" data-playtomic-knop>{p.laadLabel}</button>
        </div>
      </div>

      <p class="playtomic__fallback">
        <a href={bedrijf.playtomic} rel="noopener" target="_blank">{p.fallbackLabel}</a>
      </p>
    </div>
  </section>
)}

<style>
  .playtomic {
    position: relative;
    width: 100%;
    min-height: 700px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--wit);
    border: 1px solid rgb(20 22 28 / 0.08);
  }
  @media (min-width: 768px) { .playtomic { min-height: 820px; } }

  .playtomic :global(.playtomic__frame) {
    display: block;
    width: 100%;
    min-height: inherit;
    height: 820px;
    border: 0;
  }

  .playtomic__wacht {
    position: absolute; inset: 0;
    display: grid; place-items: center;
  }
  .playtomic[data-geladen] .playtomic__wacht { display: none; }

  .playtomic__fallback { margin-top: 1rem; text-align: left; }
  .playtomic__fallback a { color: var(--blauw); font-weight: 500; }
</style>

<script>
  const wrap = document.querySelector('[data-playtomic]');
  if (wrap) {
    const laad = () => {
      if (wrap.hasAttribute('data-geladen')) return;
      const f = document.createElement('iframe');
      f.src = wrap.dataset.src;
      f.title = wrap.dataset.title;
      f.className = 'playtomic__frame';
      f.setAttribute('allow', 'payment');
      f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      wrap.appendChild(f);
      wrap.setAttribute('data-geladen', '');
    };
    wrap.querySelector('[data-playtomic-knop]')?.addEventListener('click', laad);
  }
</script>
