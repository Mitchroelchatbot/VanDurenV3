---
import nav from '../content/nl/navigatie.json';
import { slug } from '../lib/slug.js';

// Basis: één doorlopend formulier dat zonder JavaScript werkt. Voorwaardelijke
// vragen worden zonder JS via CSS :has() verborgen; met JS wordt het formulier
// een gesprek: één vraag tegelijk, antwoorden als knoppen, eerdere antwoorden
// als bubbels. Zelfde velden, zelfde name-attributen, zelfde Netlify-form.
// `id` is optioneel: staat hij er, dan krijgt het formulier dat id en per
// optie van de eerste vraag een anker `#<id>-<slug>`, zodat een kaart elders
// op de pagina de eerste vraag alvast kan beantwoorden (bijv. Kinderfeestje).
const { naam, id, titel, intro, stappen, bevestiging, aantalGrens } = Astro.props;
const L = nav.formulierLabels;
const grensVraag = stappen.find((st) => st.type === 'aantal')?.nr;
const isEmail = (v) => /mail/i.test(v);
const esc = (s) => String(s).replace(/\\/g, '\\\\').replace(/"/g, '\\"');
const vraagVan = (nr) => stappen.find((s) => String(s.nr) === String(nr))?.vraag ?? '';

// Opties zijn een string ("Bedrijf") of een object { waarde, sub, noot, toonBij }.
// - sub: tweede regel op de chip (prijs, toelichting)
// - noot: { tekst, link: { href, label } } — verschijnt onder het antwoord
//   (doorverwijzing), het formulier gaat gewoon door
// - toonBij: { stap, waarde|waarden[] } — optie alleen als een eerder antwoord past
// De ingestuurde waarde is altijd de leesbare tekst, nooit een code.
const optie = (o) => (typeof o === 'string' ? { waarde: o } : o);
const waarden = (tb) => [].concat(tb?.waarden ?? tb?.waarde ?? []);
const opties = (st) => (st.opties ?? []).map(optie);
const opentTekstveld = (st, w) => [].concat(st.tekstveldBij ?? []).includes(w);
// Contactvelden zijn een string ("Naam", "E-mail") of een object
// { label, verplicht, type: email|tel|tekst|tekstvak, hint }.
const contactVeld = (v) => {
  if (typeof v !== 'string') return { type: 'tekst', verplicht: false, ...v };
  return { label: v, verplicht: isEmail(v), type: isEmail(v) ? 'email' : /tel/i.test(v) ? 'tel' : 'tekst' };
};
const autocompleteVoor = (t) => (t === 'email' ? 'email' : t === 'tel' ? 'tel' : t === 'tekst' ? 'name' : undefined);
const verzendLabel = stappen.find((st) => st.type === 'contact')?.verzendKnop ?? L.versturen;
const eerste = stappen[0];
const ankers = id && eerste?.type === 'keuze' ? opties(eerste).map((o) => `${id}-${slug(o.waarde)}`) : [];

// CSS die zonder JavaScript de voorwaardelijke vragen verbergt, en de
// doorverwijsregel bij een optie pas toont als die optie gekozen is.
const geenVan = (tb) => waarden(tb).map((w) => `:not(:has(input[name="${esc(vraagVan(tb.stap))}"][value="${esc(w)}"]:checked))`).join('');
const conditieCss = [
  ...stappen
    .filter((st) => st.toonBij)
    .map((st) => `form[name="${esc(naam)}"]${geenVan(st.toonBij)} fieldset[data-nr="${esc(st.nr)}"]{display:none}`),
  ...stappen.flatMap((st) => opties(st).filter((o) => o.toonBij).map((o) =>
    `form[name="${esc(naam)}"]${geenVan(o.toonBij)} fieldset[data-nr="${esc(st.nr)}"] [data-optie="${esc(o.waarde)}"]{display:none}`)),
  ...stappen.flatMap((st) => opties(st).filter((o) => o.noot).map((o) =>
    `form[name="${esc(naam)}"] fieldset[data-nr="${esc(st.nr)}"]:not(:has(input[value="${esc(o.waarde)}"]:checked)) [data-noot-bij="${esc(o.waarde)}"]{display:none}`)),
].join('\n');
---
<form
  class="form formulier sectie-body"
  name={naam}
  id={id}
  data-ankers={ankers.length ? JSON.stringify(ankers) : undefined}
  method="POST"
  action="/bedankt"
  data-netlify="true"
  netlify-honeypot={L.honeypotVeld}
  data-form
  data-labels={JSON.stringify(L)}
  data-bevestiging-titel={bevestiging.titel}
  data-bevestiging-tekst={bevestiging.tekst}
>
  {conditieCss && <style is:inline set:html={conditieCss} />}
  {ankers.map((a) => (<span class="form__anker" id={a}></span>))}
  <input type="hidden" name="form-name" value={naam} />
  <p class="form__honeypot">
    <label>{L.honeypotLabel} <input name={L.honeypotVeld} tabindex="-1" autocomplete="off" /></label>
  </p>

  {titel && <h2 class="form__titel">{titel}</h2>}
  {intro && <p class="form__intro">{intro}</p>}

  <div data-basis>
  {stappen.map((st) => (
    <fieldset class="form__vraag"
      data-nr={String(st.nr)}
      data-type={st.type}
      data-vraag={st.vraag}
      data-toon-bij-stap={st.toonBij ? String(st.toonBij.stap) : undefined}
      data-toon-bij-waarde={st.toonBij ? JSON.stringify(waarden(st.toonBij)) : undefined}
      data-chips={st.chips ? JSON.stringify(st.chips) : undefined}
      data-label={st.label}
      data-vervolg-direct={st.vervolgDirect ? 'true' : undefined}
      data-verder-knop={st.verderKnop ? 'true' : undefined}
    >
      <legend class="form__legenda">{st.vraag}</legend>
      {st.toelichting && <p class="form__toelichting">{st.toelichting}</p>}
      {st.type === 'tekst' && st.hint && <p class="form__toelichting">{st.hint}</p>}

      {st.type === 'tekst' && (
        <label class="form__veld">
          <span>{st.label}</span>
          <input class="form__invoer" type="text" name={st.vraag} data-leeg-invullen data-tekst
                 autocomplete="off" autocapitalize="words" />
        </label>
      )}

      {st.type === 'keuze' && (
        <>
          <div class="chips">
            <input type="radio" name={st.vraag} value={L.nietIngevuld} checked hidden data-standaard />
            {opties(st).map((o) => (
              <label class={`chip${o.sub ? ' chip--met-sub' : ''}`} data-optie={o.waarde}>
                <input type="radio" name={st.vraag} value={o.waarde} data-sub={o.sub}
                       data-noot={o.noot ? JSON.stringify(o.noot) : undefined}
                       data-optie-stap={o.toonBij ? String(o.toonBij.stap) : undefined}
                       data-optie-waarden={o.toonBij ? JSON.stringify(waarden(o.toonBij)) : undefined} />
                <span>{o.waarde}{o.sub && <small class="chip__sub">{o.sub}</small>}</span>
              </label>
            ))}
          </div>
          {opties(st).filter((o) => o.noot).map((o) => (
            <p class="form__noot" data-noot-bij={o.waarde}>{o.noot.tekst} {o.noot.link && <a href={o.noot.link.href}>{o.noot.link.label}</a>}</p>
          ))}
        </>
      )}

      {st.type === 'meerkeuze' && (
        <div class="chips">
          <input type="checkbox" name={st.vraag} value={L.nietIngevuld} checked hidden data-standaard data-leeg-vink />
          {opties(st).map((o) => (
            <label class={`chip${o.sub ? ' chip--met-sub' : ''}`}>
              <input type="checkbox" name={st.vraag} value={o.waarde} data-echte-keuze data-sub={o.sub} />
              <span>{o.waarde}{o.sub && <small class="chip__sub">{o.sub}</small>}</span>
            </label>
          ))}
        </div>
      )}

      {st.type === 'aantal' && (
        <>
          <input class="form__invoer form__invoer--kort" type="text" inputmode="numeric" pattern="[0-9]*|.*"
                 name={st.vraag} aria-label={st.vraag} data-leeg-invullen data-aantal
                 data-zacht-min={aantalGrens && st.nr === grensVraag ? String(aantalGrens.zachtMin) : undefined}
                 data-zacht-max={aantalGrens && st.nr === grensVraag ? String(aantalGrens.zachtMax) : undefined} />
          {aantalGrens && st.nr === grensVraag && (
            <p class="form__zacht" data-zacht-tekst hidden>{aantalGrens.buitenBereikTekst}</p>
          )}
        </>
      )}

      {st.type === 'datum-dagdeel' && (
        <div class="form__paar">
          <label class="form__veld">
            <span>{L.datum}</span>
            <input class="form__invoer" type="date" name={`${st.vraag} — ${L.datum}`} data-leeg-invullen data-datum />
          </label>
          <div class="form__veld">
            <span>{L.dagdeel}</span>
            <div class="chips" data-dagdeel>
              <input type="radio" name={`${st.vraag} — ${L.dagdeel}`} value={L.nietIngevuld} checked hidden data-standaard />
              {opties(st).map((o) => (
                <label class="chip"><input type="radio" name={`${st.vraag} — ${L.dagdeel}`} value={o.waarde} /><span>{o.waarde}</span></label>
              ))}
            </div>
          </div>
        </div>
      )}

      {st.type === 'keuze-plus-tekst' && (
        <>
          <div class="chips">
            <input type="radio" name={st.vraag} value={L.nietIngevuld} checked hidden data-standaard />
            {opties(st).map((o) => (
              <label class={`chip${o.sub ? ' chip--met-sub' : ''}`}>
                <input type="radio" name={st.vraag} value={o.waarde} data-sub={o.sub}
                       data-opent-tekstveld={opentTekstveld(st, o.waarde) ? 'true' : undefined} />
                <span>{o.waarde}{o.sub && <small class="chip__sub">{o.sub}</small>}</span>
              </label>
            ))}
          </div>
          <label class="form__veld" data-tekstveld data-uitgesteld={st.vervolgDirect ? undefined : true}>
            <span>{st.tekstveldLabel}</span>
            <input class="form__invoer" type="text" name={st.tekstveldLabel} data-leeg-invullen />
          </label>
        </>
      )}

      {st.type === 'ja-nee-plus-velden' && (
        <>
          <div class="chips">
            <input type="radio" name={st.vraag} value={L.nietIngevuld} checked hidden data-standaard />
            {L.jaNee.map((o) => (
              <label class="chip">
                <input type="radio" name={st.vraag} value={o} data-opent-velden={o === L.jaNee[0] ? 'true' : undefined} /><span>{o}</span>
              </label>
            ))}
          </div>
          <div data-extra-velden data-uitgesteld>
            {st.velden.map((v) => (
              <label class="form__veld"><span>{v}</span><input class="form__invoer" type="text" name={v} data-leeg-invullen /></label>
            ))}
          </div>
        </>
      )}

      {st.type === 'contact' && (
        <div data-contact>
          {st.velden.map(contactVeld).map((v) => (
            <label class="form__veld">
              <span>{v.label}{!v.verplicht && <em class="form__optioneel">{L.optioneel}</em>}</span>
              {v.hint && <small class="form__veld-hint">{v.hint}</small>}
              {v.type === 'tekstvak'
                ? <textarea class="form__invoer" rows="4" name={v.label} data-leeg-invullen={!v.verplicht || undefined} required={v.verplicht || undefined}></textarea>
                : <input class="form__invoer"
                       type={v.type === 'email' ? 'email' : v.type === 'tel' ? 'tel' : 'text'}
                       autocomplete={autocompleteVoor(v.type)}
                       name={v.label} required={v.verplicht || undefined}
                       data-email={v.type === 'email' ? 'true' : undefined}
                       data-leeg-invullen={!v.verplicht || undefined} />}
            </label>
          ))}
          {st.extra && (
            <label class="form__veld">
              <span>{st.extra.label}<em class="form__optioneel">{L.optioneel}</em></span>
              <textarea class="form__invoer" rows="4" name={st.extra.label} data-leeg-invullen
                        placeholder={st.extra.placeholder ?? undefined}></textarea>
            </label>
          )}
        </div>
      )}
    </fieldset>
  ))}
  </div>

  {/* Na de basisvelden, zodat de contactvelden in de inzending ná de vragen
      komen: Netlify toont de velden in DOM-volgorde. */}
  <div class="gesprek" data-gesprek hidden>
    <p class="gesprek__voortgang" data-voortgang></p>
    <div class="gesprek__bubbels" data-bubbels></div>
    <div class="gesprek__huidig" data-huidig aria-live="polite"></div>
  </div>

  <div class="form__afsluiting" data-afsluiting>
    <button class="knop knop--primair" type="submit" data-versturen>{verzendLabel}</button>
    <p class="form__hint">{L.hint}</p>
  </div>
  <p class="form__bevestiging" data-bevestiging-regel>{bevestiging.tekst}</p>
</form>

<style>
  .form { max-width: var(--max-smal); scroll-margin-top: 6rem; }
  .form__anker { display: block; height: 0; scroll-margin-top: 6rem; }
  .form__honeypot { position: absolute; left: -9999px; }
  .form__titel { margin-bottom: 0.35em; }
  .form__intro { color: var(--grijs-500); }

  .form__vraag { border: 0; padding: 0; margin: 0 0 2rem; }
  /* Formuliervraag 19/22 uit tokens.css regel 5. */
  .form__legenda { font-family: var(--font-kop); font-weight: 600; font-size: clamp(19px, 1.6vw, 22px); padding: 0; margin-bottom: 0.7rem; }
  .form__toelichting { font-size: 0.95rem; color: var(--grijs-500); margin-top: -0.35rem; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { position: relative; display: inline-flex; }
  .chip input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .chip span, .chip--knop {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0.55em 1.1em;
    border: 2px solid var(--grijs-500); border-radius: 999px;
    background: var(--wit); color: var(--inkt); font: inherit; font-size: 0.95rem; line-height: 1.2; cursor: pointer;
  }
  .chip--knop[hidden] { display: none; }
  .chip:hover span, .chip--knop:hover { border-color: var(--blauw); }
  .chip input:checked + span, .chip--knop[aria-pressed='true'] { background: var(--blauw); border-color: var(--blauw); color: var(--wit); }
  .chip input:focus-visible + span, .chip--knop:focus-visible { outline: 3px solid var(--focus-donker); outline-offset: 2px; }
  .chip--stil { border-style: dashed; color: var(--grijs-500); }
  /* Optie met een tweede regel (prijs, toelichting): twee regels, links uitgelijnd. */
  .chip--met-sub span, .chip--knop.chip--met-sub { flex-direction: column; align-items: flex-start; gap: 0.15em; text-align: left; }
  .chip__sub { display: block; font-size: 0.8rem; font-weight: 400; color: var(--grijs-500); }
  .chip input:checked + span .chip__sub, .chip--knop[aria-pressed='true'] .chip__sub { color: var(--wit); opacity: 0.88; }
  .form__noot { font-size: 0.95rem; margin: 0.75rem 0 0; }
  .form__noot a { color: var(--blauw); }
  .form__veld-hint { display: block; font-size: 0.85rem; color: var(--grijs-500); margin: -0.15rem 0 0.35rem; }

  .form__veld { display: block; margin-top: 1rem; }
  .form__veld > span { display: block; font-size: 0.9rem; margin-bottom: 0.3rem; }
  .form__optioneel { font-style: normal; color: var(--grijs-500); font-size: 0.85em; margin-left: 0.4em; }
  .form__invoer {
    width: 100%; min-height: 48px; padding: 0.7em 0.8em; font: inherit; color: var(--inkt);
    border: 2px solid var(--grijs-500); border-radius: var(--radius-klein); background: var(--wit);
  }
  .form__invoer--kort { max-width: 10rem; }
  .form__paar { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .form__paar { grid-template-columns: 1fr 1fr; } }
  .form__zacht { font-size: 0.9rem; color: var(--oranje); margin: 0.4rem 0 0; }

  .form__afsluiting { margin-top: 2rem; }
  .form__hint { font-size: 0.85rem; color: var(--grijs-500); margin: 0.6rem 0 0; }
  .form__bevestiging { font-size: 0.9rem; color: var(--grijs-500); margin-top: 1rem; }
  [data-versturen][disabled] { opacity: 0.55; cursor: not-allowed; }

  /* --- Gesprekslaag (alleen met JavaScript) --- */
  .gesprek__voortgang { font-size: 0.85rem; color: var(--grijs-500); margin: 0 0 1rem; }
  .gesprek__bubbels { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; }
  .bubbel {
    display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;
    width: 100%; padding: 0.5rem 0.25rem;
    background: none; border: 0; border-bottom: 1px solid var(--grijs-100); cursor: pointer; font: inherit;
  }
  .bubbel:hover { background: var(--grijs-100); }
  .bubbel:focus-visible { outline: 3px solid var(--focus-donker); outline-offset: 2px; }
  .bubbel__vraag { font-size: 0.85rem; color: var(--grijs-500); flex: 1 1 12rem; }
  .bubbel__antwoord {
    display: inline-flex; align-items: center; min-height: 36px; padding: 0.35em 0.9em;
    border-radius: 999px; background: var(--blauw); color: var(--wit); font-size: 0.9rem;
  }
  .gesprek__huidig .form__vraag { margin-bottom: 1rem; }
  .gesprek__huidig:focus { outline: none; }
  .gesprek__mini { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.6rem; }
  .gesprek__mini .form__invoer { max-width: 9rem; }
  .gesprek__mini--breed .form__invoer { max-width: 20rem; }
  .gesprek__noot { font-size: 0.95rem; margin: -0.25rem 0 0.75rem 0.25rem; }
  .gesprek__fout { color: var(--oranje); font-size: 0.9rem; margin-top: 0.6rem; }
  .samenvatting__kop { margin-bottom: 0.5rem; }
</style>

<script>
  import { slug } from '../lib/slug.js';

  document.querySelectorAll('form[data-form]').forEach((form) => {
    const L = JSON.parse(form.dataset.labels || '{}');

    // Astro schrijft componentstijlen met een data-astro-cid-attribuut. Alles
    // wat dit script aanmaakt heeft dat attribuut niet en blijft dus
    // ongestyled. Daarom kopiëren we het van het formulier naar elk nieuw
    // element; anders zijn de chips kale buttons.
    const cid = [...form.attributes].map((a) => a.name).find((n) => n.startsWith('data-astro-cid'));
    const maak = (tag) => { const el = document.createElement(tag); if (cid) el.setAttribute(cid, ''); return el; };
    const scope = (el) => { if (cid) { el.setAttribute(cid, ''); el.querySelectorAll('*').forEach((k) => k.setAttribute(cid, '')); } return el; };
    const basis = form.querySelector('[data-basis]');
    const gesprek = form.querySelector('[data-gesprek]');
    const bubbelsEl = form.querySelector('[data-bubbels]');
    const huidigEl = form.querySelector('[data-huidig]');
    const voortgangEl = form.querySelector('[data-voortgang]');
    const afsluiting = form.querySelector('[data-afsluiting]');
    const knop = form.querySelector('[data-versturen]');
    const email = form.querySelector('[data-email]');
    const stappen = [...form.querySelectorAll('.form__vraag')].map((el) => ({
      el, nr: el.dataset.nr, type: el.dataset.type, vraag: el.dataset.vraag,
      toonBij: el.dataset.toonBijStap ? { stap: el.dataset.toonBijStap, waarden: JSON.parse(el.dataset.toonBijWaarde) } : null,
      chips: el.dataset.chips ? JSON.parse(el.dataset.chips) : null,
      label: el.dataset.label || el.dataset.vraag,
      vervolgDirect: el.dataset.vervolgDirect === 'true',
      verderKnop: el.dataset.verderKnop === 'true',
    }));
    const antwoorden = []; // { stap, tekst, waarde }

    // Bij het opbouwen van het formulier wordt GEEN focus gezet. Zou dat wel
    // gebeuren, dan trekt de browser die vraag in beeld en opent /banen niet op
    // de h1 maar halverwege de pagina. Focus verplaatst alleen na een handeling
    // van de bezoeker: een antwoord, of een klik op een eerdere bubbel.
    let eersteRender = true;
    const zacht = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const naarBeeld = (el) => el.scrollIntoView({ block: 'nearest', behavior: zacht ? 'smooth' : 'auto' });

    // ---------- gedeeld: knop pas actief bij geldig e-mailadres ----------
    const toets = () => { if (knop && email) knop.disabled = !email.checkValidity() || email.value.trim() === ''; };
    if (knop && email) { toets(); email.addEventListener('input', toets); }

    // ---------- gedeeld: voorwaardelijke subvelden in de basisweergave ----------
    const stelSubvelden = () => {
      form.querySelectorAll('[data-tekstveld]').forEach((el) => { el.hidden = !el.closest('fieldset').querySelector('[data-opent-tekstveld]:checked'); });
      form.querySelectorAll('[data-extra-velden]').forEach((el) => { el.hidden = !el.closest('fieldset').querySelector('[data-opent-velden]:checked'); });
    };
    form.addEventListener('change', (e) => {
      stelSubvelden();
      const t = e.target;
      if (t.matches('[data-echte-keuze]')) {
        const v = t.closest('fieldset'); const leeg = v.querySelector('[data-leeg-vink]');
        if (leeg) leeg.checked = !v.querySelector('[data-echte-keuze]:checked');
      }
    });

    // ---------- gedeeld: lege velden markeren bij versturen ----------
    const markeerLeeg = () => {
      form.querySelectorAll('[data-leeg-invullen]').forEach((el) => {
        if (el.disabled || el.value.trim() !== '') return;
        const tekstachtig = el.tagName === 'TEXTAREA' || ['text', 'tel', 'email', ''].includes(el.type);
        if (tekstachtig) { el.value = L.nietIngevuld; return; }
        const v = maak('input'); v.type = 'hidden'; v.name = el.name; v.value = L.nietIngevuld;
        el.disabled = true; form.appendChild(v);
      });
    };

    // ---------- gesprek ----------
    const antwoordOp = (nr) => antwoorden.find((a) => a.stap.nr === String(nr));
    const gesteld = (st) => !st.toonBij || st.toonBij.waarden.includes(antwoordOp(st.toonBij.stap)?.waarde);
    // Optie met eigen conditie (data-optie-stap): alleen als het eerdere antwoord in de lijst staat.
    const optieMag = (i) => !i.dataset.optieStap || JSON.parse(i.dataset.optieWaarden).includes(antwoordOp(i.dataset.optieStap)?.waarde);
    const gesteldeStappen = () => stappen.filter(gesteld);
    const volgende = () => gesteldeStappen().find((st) => !antwoordOp(st.nr));

    function zetRadio(st, waarde) {
      let inp = st.el.querySelector(`input[type="radio"][value="${CSS.escape(waarde)}"]`);
      if (!inp) { inp = maak('input'); inp.type = 'radio'; inp.hidden = true;
        inp.name = st.el.querySelector('input[type="radio"]').name; inp.value = waarde; st.el.querySelector('.chips').appendChild(inp); }
      inp.checked = true;
    }
    function wisStap(st) {
      st.el.querySelectorAll('input[type="radio"]').forEach((i) => { i.checked = i.hasAttribute('data-standaard'); });
      st.el.querySelectorAll('input[type="checkbox"]').forEach((i) => { i.checked = i.hasAttribute('data-standaard'); });
      st.el.querySelectorAll('input[type="text"], input[type="date"], input[type="tel"], textarea').forEach((i) => { i.value = ''; i.disabled = false; });
    }

    function chipKnop(tekst, klasse = '', sub = '') {
      const b = maak('button'); b.type = 'button'; b.className = 'chip--knop ' + klasse + (sub ? ' chip--met-sub' : '');
      b.dataset.waarde = tekst;
      if (sub) { const t = maak('span'); t.textContent = tekst; const k = maak('small'); k.className = 'chip__sub'; k.textContent = sub; b.append(t, k); }
      else b.textContent = tekst;
      return b;
    }
    // Opties uit de statische inputs: waarde plus eventuele tweede regel.
    const optiesVan = (el, selector) => [...el.querySelectorAll(selector)].filter(optieMag).map((i) => ({ waarde: i.value, sub: i.dataset.sub || '' }));
    function chipsRij(opties, bijKeuze, { weetNiet = true, stil = [] } = {}) {
      const rij = maak('div'); rij.className = 'chips';
      opties.forEach((o) => { const w = typeof o === 'string' ? o : o.waarde; const b = chipKnop(w, '', typeof o === 'string' ? '' : o.sub);
        b.addEventListener('click', () => bijKeuze(w, b)); rij.appendChild(b); });
      stil.forEach(([tekst, fn]) => { const b = chipKnop(tekst, 'chip--stil'); b.addEventListener('click', () => fn(b)); rij.appendChild(b); });
      // Geen generieke "Weet ik nog niet" als de content die optie zelf al heeft.
      const heeftWeetNiet = opties.some((o) => (typeof o === 'string' ? o : o.waarde) === L.weetNogNiet);
      if (weetNiet && !heeftWeetNiet) { const b = chipKnop(L.weetNogNiet, 'chip--stil'); b.addEventListener('click', () => bijKeuze(L.nogNietBekend, b, L.weetNogNiet)); rij.appendChild(b); }
      return rij;
    }
    function miniInvoer(type, bevestig, { numeriek = type === 'text', label = '', leegOk = false, breed = false } = {}) {
      const wrap = maak('div'); wrap.className = 'gesprek__mini' + (breed ? ' gesprek__mini--breed' : '');
      const inp = maak('input'); inp.className = 'form__invoer'; inp.type = type;
      if (numeriek) { inp.inputMode = 'numeric'; } else { inp.autocapitalize = 'words'; inp.autocomplete = 'off'; }
      if (label) inp.setAttribute('aria-label', label);
      const ok = chipKnop(L.verder); ok.addEventListener('click', () => { if (leegOk || inp.value.trim()) bevestig(inp.value.trim()); });
      inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); ok.click(); } });
      wrap.append(inp, ok); setTimeout(() => inp.focus({ preventScroll: true }), 0); return wrap;
    }

    function beantwoord(st, tekst, waarde) {
      antwoorden.push({ stap: st, tekst, waarde });
      // alles ná deze stap dat al beantwoord was, is niet meer geldig
      teken();
    }

    function toonVraag(st) {
      huidigEl.innerHTML = '';
      const kop = maak('p'); kop.className = 'form__legenda'; kop.textContent = st.vraag; kop.tabIndex = -1;
      huidigEl.appendChild(kop);
      const toel = st.el.querySelector('.form__toelichting'); if (toel) huidigEl.appendChild(toel.cloneNode(true));
      const opties = optiesVan(st.el, '.chips > .chip input');

      if (st.type === 'tekst') {
        // Vrije tekst (bijv. een voornaam): één invoerveld met een Verder-knop.
        const veld = st.el.querySelector('[data-tekst]');
        huidigEl.appendChild(miniInvoer('text', (v) => { veld.value = v; beantwoord(st, v, v); },
          { numeriek: false, label: st.label, breed: true }));
      } else if (st.type === 'keuze-plus-tekst' && st.vervolgDirect) {
        // De vervolgvraag ("Met wie?") komt meteen na de keuze, niet pas bij de
        // contactstap. Het tekstveld mag leeg blijven; de keuze zelf telt.
        const tekstveld = st.el.querySelector('[data-tekstveld] input');
        const vervolgLabel = st.el.querySelector('[data-tekstveld] > span')?.textContent ?? '';
        huidigEl.appendChild(chipsRij(opties, (o, _b, label) => {
          zetRadio(st, o);
          if (!st.el.querySelector('[data-opent-tekstveld]:checked')) { tekstveld.value = ''; beantwoord(st, label || o, o); return; }
          huidigEl.querySelectorAll('.chips').forEach((e) => e.remove());
          const sub = maak('p'); sub.className = 'form__toelichting'; sub.textContent = vervolgLabel; huidigEl.appendChild(sub);
          huidigEl.appendChild(miniInvoer('text', (v) => { tekstveld.value = v; beantwoord(st, v ? `${o} · ${v}` : o, o); },
            { numeriek: false, label: vervolgLabel, leegOk: true, breed: true }));
        }));
      } else if (st.type === 'keuze' || st.type === 'keuze-plus-tekst' || st.type === 'ja-nee-plus-velden') {
        huidigEl.appendChild(chipsRij(opties, (o, _b, label) => { zetRadio(st, o); beantwoord(st, label || o, o); }));
      } else if (st.type === 'meerkeuze' && st.verderKnop) {
        // Variant met Verder-knop: aanvinken is hier geen antwoord maar een
        // selectie, en de knop verschijnt zodra er minstens één gekozen is.
        const echte = [...st.el.querySelectorAll('[data-echte-keuze]')];
        const gekozen = new Set(echte.filter((i) => i.checked).map((i) => i.value));
        const verder = chipKnop(L.verder); verder.hidden = gekozen.size === 0;
        const rij = chipsRij(opties, (o, b) => {
          gekozen.has(o) ? gekozen.delete(o) : gekozen.add(o);
          b.setAttribute('aria-pressed', String(gekozen.has(o)));
          echte.forEach((i) => { i.checked = gekozen.has(i.value); });
          st.el.querySelector('[data-leeg-vink]').checked = gekozen.size === 0;
          verder.hidden = gekozen.size === 0;
        }, { weetNiet: false });
        rij.querySelectorAll('.chip--knop').forEach((b) => { b.setAttribute('aria-pressed', String(gekozen.has(b.dataset.waarde))); });
        verder.addEventListener('click', () => { const lijst = echte.filter((i) => i.checked).map((i) => i.value); beantwoord(st, lijst.join(', '), lijst.join(', ')); });
        const weet = chipKnop(L.weetNogNiet, 'chip--stil');
        weet.addEventListener('click', () => { const i = maak('input'); i.type = 'checkbox'; i.hidden = true; i.checked = true;
          i.name = st.el.querySelector('[data-leeg-vink]').name; i.value = L.nogNietBekend; st.el.querySelector('.chips').appendChild(i);
          echte.forEach((x) => { x.checked = false; });
          st.el.querySelector('[data-leeg-vink]').checked = false; beantwoord(st, L.weetNogNiet, L.nogNietBekend); });
        rij.append(weet); huidigEl.appendChild(rij);
        const knopRij = maak('div'); knopRij.className = 'chips'; knopRij.appendChild(verder); huidigEl.appendChild(knopRij);
      } else if (st.type === 'meerkeuze') {
        // Eén tik is een antwoord en gaat door. Wie meer dagen wil, tikt op de
        // bubbel: de vraag opent dan opnieuw met de eerdere keuze nog aan, en
        // elke extra tik voegt toe en gaat weer door. Geen aparte verder-knop.
        const echte = [...st.el.querySelectorAll('[data-echte-keuze]')];
        const gekozen = new Set(echte.filter((i) => i.checked).map((i) => i.value));
        const rij = chipsRij(opties, (o) => {
          gekozen.has(o) ? gekozen.delete(o) : gekozen.add(o);
          echte.forEach((i) => { i.checked = gekozen.has(i.value); });
          st.el.querySelector('[data-leeg-vink]').checked = gekozen.size === 0;
          if (gekozen.size === 0) { toonVraag(st); return; }
          const lijst = echte.filter((i) => i.checked).map((i) => i.value);
          beantwoord(st, lijst.join(', '), lijst.join(', '));
        }, { weetNiet: false });
        rij.querySelectorAll('.chip--knop').forEach((b) => { if (gekozen.has(b.dataset.waarde)) b.setAttribute('aria-pressed', 'true'); });
        const weet = chipKnop(L.weetNogNiet, 'chip--stil');
        weet.addEventListener('click', () => { const i = maak('input'); i.type = 'checkbox'; i.hidden = true; i.checked = true;
          i.name = st.el.querySelector('[data-leeg-vink]').name; i.value = L.nogNietBekend; st.el.querySelector('.chips').appendChild(i);
          echte.forEach((x) => { x.checked = false; });
          st.el.querySelector('[data-leeg-vink]').checked = false; beantwoord(st, L.weetNogNiet, L.nogNietBekend); });
        rij.appendChild(weet); huidigEl.appendChild(rij);
      } else if (st.type === 'aantal') {
        const veld = st.el.querySelector('[data-aantal]');
        const rij = chipsRij(st.chips || [], (o) => { veld.value = o; beantwoord(st, o, o); },
          { stil: [[L.anders, (b) => { rij.after(miniInvoer('text', (v) => { veld.value = v; beantwoord(st, v, v); })); b.disabled = true; }]] });
        huidigEl.appendChild(rij);
      } else if (st.type === 'datum-dagdeel') {
        const datumVeld = st.el.querySelector('[data-datum]');
        const dagdeelOpties = [...st.el.querySelectorAll('[data-dagdeel] .chip input')].map((i) => i.value);
        let wanneer = null;
        const vraagDagdeel = () => {
          huidigEl.querySelectorAll('.chips, .gesprek__mini').forEach((e) => e.remove());
          const sub = maak('p'); sub.className = 'form__toelichting'; sub.textContent = L.dagdeel; huidigEl.appendChild(sub);
          huidigEl.appendChild(chipsRij(dagdeelOpties, (o, _b, label) => {
            const dg = st.el.querySelector('[data-dagdeel]');
            let inp = dg.querySelector(`input[value="${CSS.escape(o)}"]`);
            if (!inp) { inp = maak('input'); inp.type = 'radio'; inp.hidden = true; inp.name = dg.querySelector('input').name; inp.value = o; dg.appendChild(inp); }
            inp.checked = true;
            beantwoord(st, `${wanneer} · ${label || o}`, wanneer);
          }));
        };
        const zetWanneer = (v, label) => { datumVeld.type = 'text'; datumVeld.value = v; wanneer = label || v; vraagDagdeel(); };
        const rij = chipsRij(L.wanneerChips, (o) => zetWanneer(o), {
          stil: [[L.kiesDatum, (b) => { b.disabled = true; rij.after(miniInvoer('date', (v) => zetWanneer(v))); }]],
        });
        // "Weet ik nog niet" voor de datum
        const weet = rij.querySelector('.chip--stil:last-child'); weet.onclick = () => zetWanneer(L.nogNietBekend, L.weetNogNiet);
        huidigEl.appendChild(rij);
      } else if (st.type === 'contact') {
        // Laatste stap: de echte tekstvelden, plus uitgestelde subvelden van eerdere antwoorden.
        const blok = st.el.querySelector('[data-contact]'); blok.hidden = false;
        antwoorden.filter((a) => !a.stap.vervolgDirect).forEach((a) => a.stap.el.querySelectorAll('[data-uitgesteld]').forEach((u) => {
          const open = u.matches('[data-tekstveld]') ? a.stap.el.querySelector('[data-opent-tekstveld]:checked') : a.stap.el.querySelector('[data-opent-velden]:checked');
          if (open) { u.hidden = false; huidigEl.appendChild(u); }
        }));
        huidigEl.appendChild(blok);
        afsluiting.hidden = false; toets();
      }
      if (!eersteRender) { kop.focus({ preventScroll: true }); naarBeeld(huidigEl); }
    }

    function teken() {
      // bubbels
      bubbelsEl.innerHTML = '';
      antwoorden.forEach((a, i) => {
        const b = maak('button'); b.type = 'button'; b.className = 'bubbel';
        b.setAttribute('aria-label', `${L.aanpassen}: ${a.stap.vraag}`);
        b.innerHTML = `<span class="bubbel__vraag"></span><span class="bubbel__antwoord"></span>`;
        scope(b);
        b.firstChild.textContent = a.stap.vraag; b.lastChild.textContent = a.tekst;
        const gekozenInput = a.stap.el.querySelector(`input[value="${CSS.escape(a.waarde)}"][data-noot]`);
        b.addEventListener('click', () => {
          antwoorden.splice(i).forEach((x, j) => { if (!(j === 0 && x.stap.type === 'meerkeuze')) wisStap(x.stap); });
          // ook stappen die daardoor niet meer gesteld worden, wissen
          stappen.forEach((st) => { if (!gesteld(st)) wisStap(st); });
          afsluiting.hidden = true; teken();
        });
        bubbelsEl.appendChild(b);
        if (gekozenInput) {
          // Doorverwijzing (bijv. "15 jaar of ouder" → lessen): de regel uit de
          // content, met de link. Het formulier gaat gewoon door.
          const noot = JSON.parse(gekozenInput.dataset.noot);
          const n = maak('p'); n.className = 'gesprek__noot';
          n.textContent = (noot.tekst || '') + ' ';
          if (noot.link) { const l = maak('a'); l.href = noot.link.href; l.textContent = noot.link.label; n.appendChild(l); }
          bubbelsEl.appendChild(n);
        }
      });
      // voortgang: alleen wat daadwerkelijk gesteld wordt
      const lijst = gesteldeStappen();
      const n = Math.min(antwoorden.length + 1, lijst.length);
      voortgangEl.textContent = L.voortgang.replace('{n}', n).replace('{van}', lijst.length);
      const st = volgende();
      if (st) toonVraag(st);
    }

    // ---------- versturen ----------
    form.addEventListener('submit', (e) => {
      // niet-gestelde voorwaardelijke vragen als "overgeslagen" meesturen
      if (!gesprek.hidden) stappen.forEach((st) => {
        if (gesteld(st)) return;
        st.el.querySelectorAll('input[type="radio"][data-standaard], input[type="checkbox"][data-standaard]').forEach((i) => { i.value = L.overgeslagen; i.checked = true; });
        st.el.querySelectorAll('[data-leeg-invullen]').forEach((i) => { i.value = L.overgeslagen; i.disabled = false; if (i.type === 'date') i.type = 'text'; });
        st.el.querySelectorAll('[data-echte-keuze]').forEach((i) => { i.checked = false; });
      });
      markeerLeeg();
      if (gesprek.hidden || !window.fetch) return; // gewone POST
      e.preventDefault();
      knop.disabled = true; knop.textContent = L.bezig;
      const body = new URLSearchParams(new FormData(form)).toString();
      fetch(form.getAttribute('action') || '/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body })
        .then((r) => { if (!r.ok) throw new Error(String(r.status)); toonSamenvatting(); })
        .catch(() => { form.submit(); });
    });

    function toonSamenvatting() {
      const kop = maak('h3'); kop.className = 'samenvatting__kop'; kop.textContent = form.dataset.bevestigingTitel;
      const lijst = maak('div'); lijst.className = 'gesprek__bubbels';
      antwoorden.forEach((a) => { const r = maak('div'); r.className = 'bubbel'; r.innerHTML = `<span class="bubbel__vraag"></span><span class="bubbel__antwoord"></span>`;
        scope(r); r.firstChild.textContent = a.stap.vraag; r.lastChild.textContent = a.tekst; lijst.appendChild(r); });
      const tekst = maak('p'); tekst.textContent = form.dataset.bevestigingTekst;
      form.querySelectorAll(':scope > *:not(style)').forEach((el) => { el.hidden = true; });
      const s = maak('div'); s.append(kop, lijst, tekst); form.appendChild(s);
      kop.tabIndex = -1; kop.focus({ preventScroll: true }); naarBeeld(kop);
    }

    // ---------- voorselectie via #<id>-<slug> ----------
    // Een kaart op dezelfde pagina linkt naar bijv. #aanvraag-kinderfeestje.
    // Bestaat dat anker, dan is de eerste vraag daarmee beantwoord.
    const ankers = form.dataset.ankers ? JSON.parse(form.dataset.ankers) : [];
    const kiesUitHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (!h || !ankers.includes(h)) return false;
      const st = stappen[0];
      const optie = optiesVan(st.el, '.chips > .chip input').find((o) => `${form.id}-${slug(o.waarde)}` === h);
      if (!optie) return false;
      antwoorden.splice(0).forEach((x) => wisStap(x.stap));
      stappen.forEach((x) => wisStap(x));
      afsluiting.hidden = true;
      zetRadio(st, optie.waarde); beantwoord(st, optie.waarde, optie.waarde);
      return true;
    };
    window.addEventListener('hashchange', () => { kiesUitHash(); });

    // ---------- start ----------
    basis.hidden = true; afsluiting.hidden = true; form.querySelector('[data-bevestiging-regel]').hidden = true;
    gesprek.hidden = false;
    if (!kiesUitHash()) teken();
    eersteRender = false;
  });
</script>
