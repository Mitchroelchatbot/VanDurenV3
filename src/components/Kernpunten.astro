---
import Foto from './Foto.astro';
import home from '../content/nl/home.json';
import beeld from '../content/nl/home-beeld.json';

// Tekst links, staande foto rechts op volle sectiehoogte; mobiel de foto boven
// de tekst. Ondertekening klein en cursief onder de punten, boven de knop.
// Het blok staat links: het is een lijst (tokens.css regel 4).
// Zonder foto (kernpunten.foto null, zie _todo) één kolom.
const k = home.kernpunten;
const foto = k?.foto ? beeld.fotos[k.foto] : null;
---
{k && (
  <section class="sectie kern sectie-body">
    <div class="omhulsel omhulsel--midden kern__raster" data-met-foto={foto ? 'true' : 'false'}>
      {foto && (
        <div class="kern__foto">
          <Foto basis={foto.basis} maten={foto.maten} alt={k.fotoAlt ?? ''}
                breedte={foto.breedte} hoogte={foto.hoogte} sizes="(min-width: 900px) 40vw, 100vw" />
        </div>
      )}
      <div class="kern__tekst">
        <h2 class="kern__kop">{k.kop}</h2>
        <span class="kern__streep" aria-hidden="true"></span>
        <p class="kern__intro">{k.intro}</p>
        <ul class="kern__punten">
          {k.punten.map((p) => (
            <li class="kern__punt">
              <span class="kern__label">{p.label}</span>
              <span class="kern__uitleg">{p.tekst}</span>
              {p.link && <a class="kern__link" href={p.link.href}>{p.link.label}</a>}
            </li>
          ))}
        </ul>
        {k.ondertekening && <p class="kern__ondertekening">{k.ondertekening}</p>}
        <p class="kern__actie"><a class="knop knop--secundair" href={k.cta.href}>{k.cta.label}</a></p>
      </div>
    </div>
  </section>
)}

<style>
  .kern__kop { margin-bottom: 0; }
  .kern__streep { display: block; width: 60px; height: 4px; border-radius: 2px; background: var(--blauw); margin: 0.85rem 0 0; }
  .kern__intro { margin: clamp(1rem, 2.5vw, 1.5rem) 0 0; max-width: 60ch; }
  .kern__punten { list-style: none; margin: clamp(2rem, 5vw, 3rem) 0 0; padding: 0; display: grid; gap: clamp(1.1rem, 2.5vw, 1.5rem); }
  .kern__punt { position: relative; padding-left: 1.75rem; }
  .kern__punt::before {
    content: ''; position: absolute; left: 0; top: 0.45em; width: 7px; height: 7px;
    border-right: 2px solid var(--blauw); border-top: 2px solid var(--blauw); transform: rotate(45deg);
  }
  .kern__label { display: block; font-family: var(--font-kop); font-weight: 600; color: var(--inkt); line-height: 1.35; }
  .kern__uitleg { display: block; font-family: var(--font-tekst); color: var(--grijs-500); margin-top: 0.2rem; }
  .kern__link { display: inline-block; margin-top: 0.35rem; color: var(--blauw); font-weight: 500; }
  .kern__ondertekening { margin: clamp(1.25rem, 3vw, 1.75rem) 0 0; font-size: 0.92rem; font-style: italic; color: var(--grijs-500); }
  .kern__actie { margin: clamp(1.5rem, 4vw, 2.25rem) 0 0; }

  /* Mobiel: foto boven de tekst. */
  .kern__foto { border-radius: var(--radius); overflow: hidden; margin-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .kern__foto :global(picture), .kern__foto :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 900px) {
    /* Twee kolommen; de foto rechts en zo hoog als de tekstkolom. */
    .kern__raster[data-met-foto='true'] {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      gap: clamp(2rem, 5vw, 4rem); align-items: stretch;
    }
    .kern__raster[data-met-foto='true'] .kern__foto { order: 2; margin-bottom: 0; min-height: 100%; }
    .kern__raster[data-met-foto='true'] .kern__tekst { order: 1; }
  }
</style>
