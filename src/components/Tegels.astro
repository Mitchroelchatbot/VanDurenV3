---
import Foto from './Foto.astro';
import home from '../content/nl/home.json';
import beeld from '../content/nl/home-beeld.json';

// De hele tegel is de foto; label en regel staan eroverheen.
const t = home.tegels;
const items = t.items
  .map((it) => ({ ...it, bron: beeld.fotos[it.foto] }))
  .filter((it) => it.bron);
---
<section class="sectie tegels">
  <div class="omhulsel">
    <h2>{t.kop}</h2>
    <div class="tegels__raster">
      {items.map((it) => (
        <a class="tegel" href={it.href}>
          <span class="tegel__beeld">
            <Foto basis={it.bron.basis} maten={it.bron.maten} alt={it.fotoAlt}
                  breedte={it.bron.breedte} hoogte={it.bron.hoogte}
                  sizes="(min-width: 900px) 33vw, 100vw" />
          </span>
          <span class="tegel__tekst">
            <span class="tegel__label">{it.label}</span>
            <span class="tegel__regel">{it.regel}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tegels__raster { display: grid; gap: var(--gutter); grid-template-columns: 1fr; }
  @media (min-width: 900px) { .tegels__raster { grid-template-columns: repeat(3, 1fr); } }

  .tegel {
    position: relative; display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden; border-radius: var(--radius);
    text-decoration: none; color: var(--wit);
    background: var(--grijs-900);
  }
  .tegel__beeld { position: absolute; inset: 0; display: block; }
  .tegel__beeld :global(picture) { display: block; height: 100%; }
  .tegel__beeld :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 240ms ease-out;
  }
  /* Alleen de foto schaalt op hover, de tekst niet: die staat buiten
     .tegel__beeld en heeft dus geen transform. */
  .tegel:hover .tegel__beeld :global(img) { transform: scale(1.04); }

  /* Scrim over de onderste helft, zodat wit altijd leesbaar blijft. */
  .tegel::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top,
      rgba(20, 22, 28, 0.78) 0%,
      rgba(20, 22, 28, 0.45) 40%,
      transparent 70%);
  }
  .tegel__tekst {
    position: absolute; z-index: 1; left: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column; gap: 0.15rem;
    padding: clamp(0.9rem, 2.5vw, 1.25rem);
  }
  .tegel__label { font-family: var(--font-kop); font-weight: 700; font-size: 1.15rem; color: var(--wit); }
  .tegel__regel { font-size: 0.92rem; color: var(--wit); opacity: 0.85; }

  .tegel:focus-visible { outline: 3px solid var(--wit); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .tegel__beeld :global(img) { transition: none; } }
</style>
