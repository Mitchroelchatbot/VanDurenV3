---
import bedrijf from '../content/nl/bedrijf.json';

const dagNaar = { ma: 'Monday', di: 'Tuesday', wo: 'Wednesday', do: 'Thursday',
                  vr: 'Friday', za: 'Saturday', zo: 'Sunday' };

const { faq } = Astro.props;

const locatie = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: bedrijf.naam,
  url: 'https://indoorpadelcentrum.nl',
  telephone: bedrijf.telefoonE164,
  email: bedrijf.email,
  vatID: bedrijf.btw,
  address: {
    '@type': 'PostalAddress',
    streetAddress: bedrijf.bezoekadres.straat,
    postalCode: bedrijf.bezoekadres.postcode,
    addressLocality: bedrijf.bezoekadres.plaats,
    addressCountry: bedrijf.bezoekadres.land,
  },
  openingHoursSpecification: bedrijf.openingstijden.map((t) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: t.dagen.map((d) => dagNaar[d]),
    opens: t.open,
    closes: t.sluit,
  })),
  sameAs: bedrijf.sameAs,
};

const faqSchema = faq && faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((v) => ({
    '@type': 'Question',
    name: v.vraag,
    acceptedAnswer: { '@type': 'Answer', text: v.antwoord },
  })),
} : null;
---
{!faq && <script type="application/ld+json" set:html={JSON.stringify(locatie)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
