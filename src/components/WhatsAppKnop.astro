---
import bedrijf from '../content/nl/bedrijf.json';
import nav from '../content/nl/navigatie.json';

const { sleutel = 'algemeen' } = Astro.props;
const tekst = bedrijf.whatsappTeksten[sleutel] ?? bedrijf.whatsappTeksten.algemeen;
const href = `${bedrijf.whatsapp}?text=${encodeURIComponent(tekst)}`;
---
<a class="wa" href={href} target="_blank" rel="noopener">
  <span class="alleen-schermlezer">{nav.labels.whatsapp}</span>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.21 8.21 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 8.24 8.25c0 4.54-3.7 8.21-8.24 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.74 2.66 4.22 3.73.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/>
  </svg>
</a>

<style>
  .wa {
    position: fixed; right: clamp(14px, 4vw, 28px); bottom: clamp(14px, 4vw, 28px);
    z-index: 60; display: grid; place-items: center;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--blauw); color: var(--wit);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.28);
  }
  .wa:hover { background: var(--blauw-diep); color: var(--wit); }
  @media (min-width: 768px) { .wa { width: 50px; height: 50px; } }
</style>
