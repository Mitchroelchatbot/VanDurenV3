---
import Cta from './Cta.astro';
import KaartVideo from './KaartVideo.astro';

// prijsSub is de tweede prijsregel (bijv. de prijs per les naast de reeksprijs).
// Wordt hij meegegeven, dan staat hij er altijd; de content bepaalt dat.
const { eyebrow, label, omschrijving, punten, prijs, prijsPer, prijsSub, cta, video,
        ctaSoort = 'secundair', niveau = 2 } = Astro.props;
// Kopniveau volgt de pagina, zodat de koppenstructuur niet overslaat.
const Kop = `h${niveau}`;
---
<article class="kaart sectie-body">
  {video && <KaartVideo video={video} />}
  {eyebrow && <p class="kaart__eyebrow">{eyebrow}</p>}
  <Kop class="kaart__kop">{label}</Kop>
  {prijs && (
    <p class="kaart__prijs">{prijs}{prijsPer && <span class="kaart__prijs-per"> {prijsPer}</span>}</p>
  )}
  {prijs && prijsSub && <p class="kaart__prijs-sub">{prijsSub}</p>}
  {omschrijving && <p class="kaart__tekst">{omschrijving}</p>}
  {punten && punten.length > 0 && (
    <ul class="kaart__punten">{punten.map((p) => (<li>{p}</li>))}</ul>
  )}
  {cta && <div class="kaart__actie"><Cta cta={cta} soort={ctaSoort} /></div>}
</article>

<style>
  .kaart {
    display: flex; flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 2px solid var(--grijs-100);
    border-radius: var(--radius);
    background: var(--wit);
    height: 100%;
  }
  .kaart__eyebrow {
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--oranje); margin: 0 0 0.5rem; font-weight: 600;
  }
  .kaart__kop { font-size: 1.35rem; margin-bottom: 0.4rem; }
  .kaart__prijs { font-family: var(--font-kop); font-weight: 700; font-size: 1.5rem; margin: 0 0 0.6rem; color: var(--blauw); }
  .kaart__prijs-per { font-family: var(--font-tekst); font-weight: 400; font-size: 0.95rem; color: var(--grijs-500); }
  .kaart__prijs-sub { font-family: var(--font-kop); font-weight: 600; font-size: 1.05rem; color: var(--inkt); margin: -0.35rem 0 0.8rem; }
  .kaart__tekst { margin-bottom: 1rem; }
  .kaart__punten { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; gap: 0.4rem; }
  .kaart__punten li { position: relative; padding-left: 1.4rem; font-size: 0.95rem; }
  .kaart__punten li::before {
    content: ''; position: absolute; left: 0; top: 0.58em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--oranje-merk);
  }
  .kaart__actie { margin-top: auto; }
</style>
