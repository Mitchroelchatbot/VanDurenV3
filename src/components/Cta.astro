---
import bedrijf from '../content/nl/bedrijf.json';
import { slug } from '../lib/slug.js';

// Eén plek die een cta-object uit de content omzet naar een link.
// Verschuift Playtomic later van beleid, dan is dat hier één regel.
const { cta, soort = 'primair' } = Astro.props;
const href =
  cta.type === 'playtomic' ? bedrijf.playtomic :
  cta.type === 'playtomic-memberships' ? bedrijf.playtomicMemberships :
  cta.type === 'anker' ? cta.anker :
  // formulier + start: het formulier opent met de eerste vraag al beantwoord
  // (Formulier.astro rendert per optie een anker #<id>-<slug>).
  cta.type === 'formulier' ? `#${cta.formulier}${cta.start ? '-' + slug(cta.start) : ''}` :
  cta.href;
// (een cta met alleen 'href' is een gewone interne link)
const extern = href?.startsWith('http');
---
<a class={`knop knop--${soort}`} href={href} rel={extern ? 'noopener' : undefined}
   target={extern ? '_blank' : undefined}>{cta.label}</a>
