---
import home from '../content/nl/home.json';

// Foto rendert alleen als 'foto' gevuld is (O19). Zonder foto één kolom.
const f = home.familie;
---
<section class="sectie familie">
  <div class="omhulsel familie__raster" data-met-foto={f.foto ? 'true' : 'false'}>
    {f.foto && (
      <img class="familie__foto" src={f.foto} alt={f.fotoAlt} width="960" height="720" loading="lazy" />
    )}
    <div class="familie__tekst">
      <h2>{f.kop}</h2>
      <p>{f.alinea1}</p>
      <p>{f.alinea2}</p>
    </div>
  </div>
</section>

<style>
  .familie__raster { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (min-width: 900px) {
    .familie__raster[data-met-foto='true'] { grid-template-columns: 1fr 1fr; }
  }
  .familie__foto { border-radius: var(--radius); width: 100%; object-fit: cover; }
  .familie__tekst p:last-child { margin-bottom: 0; }
</style>
