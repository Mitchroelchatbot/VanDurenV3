---
import bedrijf from '../content/nl/bedrijf.json';
import nav from '../content/nl/navigatie.json';

const { pad } = Astro.props;
const { hoofdmenu, labels } = nav;
// De kop-CTA staat op elke pagina en elke breedte. Sinds 10 september heeft de
// hero geen knoppen meer, dus dit is boven de vouw de enige weg naar de
// boeking; verbergen was precies de klacht van de eigenaren. Onder 560px
// wordt het zichtbare label korter; de toegankelijke naam volgt het zichtbare label.
---
<header class="kop op-blauw">
  <div class="omhulsel kop__binnen">
    <a class="wordmerk" href="/">
      <span class="wordmerk__groot">{bedrijf.wordmark.regel1}</span>
      <span class="wordmerk__klein">{bedrijf.wordmark.regel2}</span>
    </a>

    <button class="kop__schakelaar" type="button" aria-expanded="false" aria-controls="hoofdnav">
      <span class="alleen-schermlezer">{labels.menuOpenen}</span>
      <span class="kop__streepjes" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="hoofdnav" class="kop__nav" aria-label={labels.hoofdnavigatie}>
      <ul>
        {hoofdmenu.map((item) => (
          <li><a href={item.pad} aria-current={item.pad === pad ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    {/* Twee labels, één zichtbaar per breedte via display. Geen aria-label:
        de toegankelijke naam moet de zichtbare tekst bevatten (WCAG 2.5.3), en
        display:none haalt het verborgen label ook uit de toegankelijkheidsboom. */}
    <a class="knop knop--primair kop__cta" href={bedrijf.playtomic} rel="noopener">
      <span class="kop__cta-lang">{labels.boekEenBaan}</span>
      <span class="kop__cta-kort">{labels.boeken}</span>
    </a>
  </div>
</header>

<style>
  .kop {
    position: sticky; top: 0; z-index: 50;
    /* De sticky header loopt met viewport-fit=cover door onder de statusbalk.
       Zonder deze inset wordt de bovenrand van de primaire knop, inclusief de
       witte ring uit tokens.css, door de notch afgesneden. Geen vaste hoogte
       en geen overflow: de ring is een box-shadow en mag niet worden geknipt. */
    padding-top: max(12px, env(safe-area-inset-top));
    padding-bottom: 12px;
    overflow: visible;
  }
  .kop__binnen {
    display: flex; align-items: center;
    gap: clamp(10px, 1.2vw, 20px);
    min-height: 60px; flex-wrap: wrap;
  }
  .wordmerk { display: flex; flex-direction: column; text-decoration: none; margin-right: auto; }
  .wordmerk__groot { font-family: var(--font-kop); font-weight: 700; font-size: 1.5rem; line-height: 1.05; letter-spacing: -0.02em; }
  .wordmerk__klein { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.92; }

  .kop__nav ul { display: flex; gap: clamp(0.6rem, 0.95vw, 1rem); list-style: none; margin: 0; padding: 0; }
  .kop__nav a { text-decoration: none; font-size: 0.875rem; padding-block: 0.4em; white-space: nowrap; }
  .kop__nav a:hover { text-decoration: underline; }
  .kop__nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.35em; }

  .kop__schakelaar { display: none; background: none; border: 0; padding: 10px; cursor: pointer; }
  .kop__streepjes { display: grid; gap: 5px; }
  .kop__streepjes i { display: block; width: 26px; height: 2px; background: var(--wit); }

  /* Altijd aanraakbaar: minimaal 44px hoog op elke breedte. */
  .kop__cta { min-height: 44px; display: inline-flex; align-items: center; }
  .kop__cta-kort { display: none; }

  /* Onder 560px moeten wordmerk, CTA en hamburger samen op één rij passen,
     anders valt de header uit elkaar en wordt hij twee rijen hoog. */
  @media (max-width: 560px) {
    .kop__binnen { gap: 10px; }
    .wordmerk__groot { font-size: 1.2rem; }
    .wordmerk__klein { font-size: 0.62rem; letter-spacing: 0.1em; }
    /* Kort label, maar de knop blijft staan en blijft 44px hoog. */
    .kop__cta { padding: 0.5em 0.9em; font-size: 0.9rem; }
    .kop__cta-lang { display: none; }
    .kop__cta-kort { display: inline; }
    .kop__schakelaar { padding: 8px 4px; }
  }

  /* Zeer smalle toestellen (320-380px): verder verkleinen zodat de rij heel
     blijft. Het wordmerk blijft volledig leesbaar, alleen kleiner. */
  @media (max-width: 380px) {
    .kop__binnen { gap: 8px; }
    .wordmerk__groot { font-size: 1.05rem; }
    .wordmerk__klein { font-size: 0.55rem; letter-spacing: 0.08em; }
    .kop__cta { padding: 0.45em 0.8em; font-size: 0.85rem; }
    .kop__schakelaar { padding: 6px 2px; }
  }

  /* Onder 340px (iPhone SE 1e generatie) past de tweede regel van het
     wordmerk er niet meer bij zonder dat de rij breekt. Daar blijft alleen
     "Van Duren" staan; de volledige naam staat in de footer en in de title. */
  @media (max-width: 340px) {
    .wordmerk__klein { display: none; }
    .kop__cta { padding: 0.45em 0.7em; font-size: 0.82rem; }
  }

  @media (max-width: 1240px) {
    .kop__binnen { min-height: 56px; }
    .kop__schakelaar { display: block; order: 3; }
    .kop__cta { order: 2; }
    .kop__nav { order: 4; flex-basis: 100%; display: none; padding-bottom: 1rem; }
    .kop__nav[data-open='true'] { display: block; }
    .kop__nav ul { flex-direction: column; gap: 0; }
    .kop__nav a { display: block; padding: 0.75em 0; }
  }
</style>

<script>
  const knop = document.querySelector('.kop__schakelaar');
  const menu = document.getElementById('hoofdnav');
  const zet = (open) => {
    knop?.setAttribute('aria-expanded', String(open));
    menu?.setAttribute('data-open', String(open));
  };
  knop?.addEventListener('click', () => zet(knop.getAttribute('aria-expanded') !== 'true'));
  // Sluiten bij elke klik op een link in het menu, ook bij een in-page anker
  // (href met #): die herlaadt de pagina niet, dus het menu bleef openstaan.
  menu?.addEventListener('click', (e) => { if (e.target.closest('a[href]')) zet(false); });
</script>
