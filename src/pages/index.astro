---
import BasisLayout from '../layouts/BasisLayout.astro';
import Hero from '../components/Hero.astro';
import Familieblok from '../components/Familieblok.astro';
import Tegels from '../components/Tegels.astro';
import paginas from '../content/nl/paginas.json';
import home from '../content/nl/homepage.json';

const pad = '/';
const meta = paginas[pad];
---
<BasisLayout pad={pad} waSjabloon={meta.wa} posterPreload={home.hero.poster?.basis}>
  <Hero />
  <Familieblok />
  <Tegels />
</BasisLayout>
