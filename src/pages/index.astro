---
import BasisLayout from '../layouts/BasisLayout.astro';
import Hero from '../components/Hero.astro';
import Overblok from '../components/Overblok.astro';
import Tegels from '../components/Tegels.astro';
import HerhaalCta from '../components/HerhaalCta.astro';
import Beeldstrook from '../components/Beeldstrook.astro';
import home from '../content/nl/home.json';

const pad = '/';
const meta = { titel: home.metaTitle, beschrijving: home.metaDescription };
---
<BasisLayout pad={pad} meta={meta} posterPreload={home.hero.poster}>
  <Hero />
  <Overblok />
  <Beeldstrook />
  <Tegels />
  <HerhaalCta />
</BasisLayout>
