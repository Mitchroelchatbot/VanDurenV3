---
import BasisLayout from '../layouts/BasisLayout.astro';
import Hero from '../components/Hero.astro';
import PersoonlijkBlok from '../components/PersoonlijkBlok.astro';
import Beeldblok from '../components/Beeldblok.astro';
import paginas from '../content/nl/paginas.json';

const pad = '/';
const meta = paginas[pad];
---
<BasisLayout pad={pad} waSjabloon={meta.wa}>
  <Hero />
  <PersoonlijkBlok />
  <Beeldblok />
</BasisLayout>
