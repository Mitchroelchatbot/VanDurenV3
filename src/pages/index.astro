---
import BasisLayout from '../layouts/BasisLayout.astro';
import Hero from '../components/Hero.astro';
import Familieblok from '../components/Familieblok.astro';
import Tegels from '../components/Tegels.astro';
import HerhaalCta from '../components/HerhaalCta.astro';
import Galerijstrook from '../components/Galerijstrook.astro';
import home from '../content/nl/home.json';
import beeld from '../content/nl/home-beeld.json';

const pad = '/';
const meta = { titel: home.metaTitle, beschrijving: home.metaDescription };
---
<BasisLayout pad={pad} meta={meta} posterPreload={beeld.poster.basis}>
  <Hero />
  <Familieblok />
  <Tegels />
  <HerhaalCta />
  <Galerijstrook />
</BasisLayout>
